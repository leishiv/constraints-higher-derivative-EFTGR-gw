# BBH prior for the EFT runs on GW230627_015337.
# Aligned spins: SEOBNRv5HM_ROM does not support precession.
# Read with bilby.gw.prior.BBHPriorDict(filename=...); building the dictionary by
# hand would silently load the default precessing priors instead.
# Note: comments must be on their own line, the parser evaluates the whole right
# hand side of each assignment.

# Masses: detector-frame chirp mass and mass ratio; bilby inverts them to m1, m2.
mass_1 = Constraint(minimum=1, maximum=1000, name='mass_1', latex_label='$m_1$')
mass_2 = Constraint(minimum=1, maximum=1000, name='mass_2', latex_label='$m_2$')
chirp_mass = bilby.gw.prior.UniformInComponentsChirpMass(minimum=6.38537095164235, maximum=6.4428834107576165, name='chirp_mass')

# Retain the archived mass-ratio support; this is not an EFT-validity cut.
mass_ratio = bilby.gw.prior.UniformInComponentsMassRatio(minimum=0.2, maximum=1.0, name='mass_ratio', latex_label='$q$')

# AlignedSpin is the projected isotropic-spin prior, not a uniform prior in chi.
chi_1 = bilby.gw.prior.AlignedSpin(name='chi_1', a_prior=Uniform(minimum=0, maximum=0.99))
chi_2 = bilby.gw.prior.AlignedSpin(name='chi_2', a_prior=Uniform(minimum=0, maximum=0.99))

# Extrinsic parameters.
luminosity_distance = bilby.gw.prior.UniformSourceFrame(name='luminosity_distance', minimum=50.0, maximum=471.599, unit='Mpc')
dec = Cosine(name='dec', boundary='reflective')
ra = Uniform(name='ra', minimum=0, maximum=2 * np.pi, boundary='periodic')
theta_jn = Sine(name='theta_jn')
psi = Uniform(name='psi', minimum=0, maximum=np.pi, boundary='periodic')
phase = Uniform(name='phase', minimum=0, maximum=2 * np.pi, boundary='periodic')

# geocent_time and beta1/beta2/beta3 are set by run_bayes.py.
